<title>NVIDIA AI Infrastructure & Operations - Study Programme</title>

<style>
:root {
  --bg: #0f172a;
  --card-bg: #111827;
  --card-border: #334155;
  --accent: #2dd4bf;
  --accent-muted: #99f6e4;
  --text-main: #e5e7eb;
  --text-muted: #cbd5e1;
  --text-strong: #f8fafc;
}

* { box-sizing: border-box; }

body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: radial-gradient(circle at top, #1e293b 0%, #0f172a 55%, #020617 100%);
  margin: 0;
  color: var(--text-main);
}

header {
  text-align: center;
  padding: 32px 16px 12px;
}

header h1 {
  margin: 0 0 6px;
  color: var(--text-strong);
}

header p {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.95rem;
}

.tagline {
  margin-top: 6px;
  font-size: 0.85rem;
  color: var(--accent-muted);
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 16px 50px;
}

/* Purpose */
.about-card {
  background: rgba(17, 24, 39, 0.95);
  border: 1px solid var(--card-border);
  border-radius: 12px;
  padding: 22px 26px;
  margin: 24px auto;
  max-width: 900px;
}

.about-title {
  font-size: 1.05rem;
  margin-bottom: 10px;
  color: var(--accent-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 600;
}

.about-text {
  font-size: 0.95rem;
  line-height: 1.6;
  margin-bottom: 10px;
}

/* Progress */
.progress-container {
  width: 100%;
  max-width: 600px;
  margin: 16px auto 6px;
  background: #020617;
  border-radius: 999px;
  border: 1px solid #1e293b;
  padding: 2px;
}

.progress-bar {
  height: 22px;
  width: 20%;
  background: linear-gradient(to right, var(--accent-muted), var(--accent));
  border-radius: 999px;
  text-align: center;
  color: #022c22;
  font-weight: 600;
  font-size: 0.85rem;
  line-height: 22px;
  transition: width 0.3s ease;
}

.progress-label {
  text-align: center;
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 6px;
}

.countdown {
  text-align: center;
  font-size: 0.9rem;
  color: var(--accent-muted);
  margin-bottom: 20px;
}

/* Tabs */
.tab {
  text-align: center;
  margin: 20px auto;
}

.tab button {
  background: transparent;
  border: 1px solid var(--card-border);
  color: var(--text-muted);
  padding: 8px 14px;
  margin: 4px;
  border-radius: 999px;
  cursor: pointer;
}

.tab button.active {
  background: var(--accent);
  color: #022c22;
  font-weight: 600;
}

/* Content */
.tabcontent {
  display: none;
  background: rgba(17, 24, 39, 0.95);
  border: 1px solid var(--card-border);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
}

.tabcontent h2 {
  margin-top: 0;
  color: var(--text-strong);
}

.section-title {
  font-weight: 600;
  margin-top: 14px;
}

ul {
  margin: 6px 0 12px 18px;
}

.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 0.75rem;
  border: 1px solid var(--card-border);
  color: var(--text-muted);
}

/* Footer */
.footer {
  margin-top: 60px;
  padding-top: 30px;
  border-top: 1px solid var(--card-border);
  text-align: center;
}

.footer-text {
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-bottom: 14px;
}

.footer-buttons a {
  display: inline-block;
  margin: 0 6px;
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid var(--card-border);
  text-decoration: none;
  font-size: 0.85rem;
  color: var(--text-main);
  background: #020617;
}

.footer-buttons a:hover {
  border-color: var(--accent);
  color: var(--accent-muted);
}
</style>

<script>
const totalWeeks = 5;
const examDate = new Date("2026-02-11T00:00:00");

function openWeek(evt, weekId, weekNumber) {
  document.querySelectorAll(".tabcontent").forEach(c => c.style.display = "none");
  document.querySelectorAll(".tab button").forEach(b => b.classList.remove("active"));
  document.getElementById(weekId).style.display = "block";
  evt.currentTarget.classList.add("active");
  updateProgress(weekNumber);
}

function updateProgress(week) {
  const percent = Math.round((week / totalWeeks) * 100);
  const bar = document.getElementById("progressBar");
  bar.style.width = percent + "%";
  bar.textContent = `Week ${week} of ${totalWeeks}`;
}

function updateCountdown() {
  const diff = examDate - new Date();
  if (diff <= 0) {
    document.getElementById("countdown").textContent = "Exam day 🚀";
    return;
  }
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  document.getElementById("countdown").textContent =
    `${days} days until exam (11 Feb)`;
}

window.onload = function() {
  document.getElementById("defaultTab").click();
  updateCountdown();
  setInterval(updateCountdown, 3600000);
};
</script>
</head>

